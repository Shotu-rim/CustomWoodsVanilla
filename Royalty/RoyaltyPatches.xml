<Patch>
 
  
 <!--Patch for Harp-->
<Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Harp"]</xpath>
    <value>
      <costStuffCount>150</costStuffCount>
      <stuffCategories>
        <li>Woody</li>
      </stuffCategories>
    </value>
  </Operation>

<Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="Harp"]/costList/WoodLog</xpath>
  </Operation>


  
