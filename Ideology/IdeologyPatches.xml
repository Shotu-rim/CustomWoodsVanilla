<Patch>
  


<!--Patch for XMassTree-->
<Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="ChristmasTree"]</xpath>
    <value>
      <costStuffCount>70</costStuffCount>
      <stuffCategories>
        <li>Woody</li>
      </stuffCategories>
    </value>
  </Operation>

<Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="ChristmasTree"]/costList/WoodLog</xpath>
  </Operation>

  
